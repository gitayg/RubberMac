<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened runtime blocks Apple Events without this: pasting a path in Finder moves its window with one. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<!-- Hardened runtime blocks the camera without this: the Eye Color Camera's helper reads it on RubberMAC's behalf. -->
	<key>com.apple.security.device.camera</key>
	<true/>
</dict>
</plist>
